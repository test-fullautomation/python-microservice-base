// main.cpp - entry point of the service's Manager GUI panel (Qt WebAssembly).
//
// Generated by the MicroserviceBase scaffold (gui_type "wasm"). The Manager
// GUI starts the module inside a tile; the window fills the tile and
// scrolls when the tile is smaller than the panel.

#include "ServicePanel.h"

#include <QApplication>
#include <QScrollArea>
#include <QStyle>
#include <QStyleHints>

int main(int argc, char *argv[])
{
    QApplication app(argc, argv);
    // A light palette whatever the browser's color scheme, and a desktop-like
    // text size.
#if QT_VERSION >= QT_VERSION_CHECK(6, 8, 0)
    app.styleHints()->setColorScheme(Qt::ColorScheme::Light);
#endif
    app.setPalette(app.style()->standardPalette());
    QFont font = app.font();
    font.setPixelSize(13);
    app.setFont(font);

    QScrollArea area;
    area.setFrameShape(QFrame::NoFrame);
    area.setWidgetResizable(true);
    area.setWidget(new ServicePanel);
    area.showFullScreen();     // in WebAssembly: fill the tile's container

    return app.exec();
}
