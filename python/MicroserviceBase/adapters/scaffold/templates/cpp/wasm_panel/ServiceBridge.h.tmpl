// ServiceBridge.h - calls the service's gRPC methods through the Manager GUI.
//
// Generated by the MicroserviceBase scaffold (gui_type "wasm"). The panel
// runs as a "wasm" tile of a Manager GUI component and never talks to the
// service itself: every call goes to window.callMicroservice, which the GUI
// answers over gRPC with the component's capabilities (component.json:
// binds.grpc). A method is "<package.Service>/<Method>".

#pragma once

#include <QHash>
#include <QJsonObject>
#include <QObject>
#include <QString>

#include <functional>

class QTimer;

class ServiceBridge : public QObject
{
    Q_OBJECT

public:
    /// response: the whole response message (proto field names);
    /// error: empty on success.
    using Reply = std::function<void(const QJsonObject &response, const QString &error)>;

    explicit ServiceBridge(QObject *parent = nullptr);

    /// Call a method with its request message; onReply runs once with the answer.
    void call(const QString &method, const QJsonObject &request = {}, Reply onReply = {});

    /// True when the panel runs inside the Manager GUI (the bridge exists).
    bool available() const;

    /// Calls sent and not answered yet.
    int pending() const { return m_pending.size(); }

private:
    void poll();

    QHash<int, Reply> m_pending;
    int m_nextId = 1;
    QTimer *m_timer = nullptr;
};
