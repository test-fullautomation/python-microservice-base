// ServicePanel.cpp - the service's panel in the Manager GUI (Qt WebAssembly).
//
// Generated by the MicroserviceBase scaffold (gui_type "wasm"); see
// ServicePanel.h. The layout comes from PANEL_SPEC (panel_spec.h), a JSON
// table of the project's services and their RPCs.

#include "ServicePanel.h"
#include "ServiceBridge.h"
#include "panel_spec.h"

#include <QCheckBox>
#include <QDoubleSpinBox>
#include <QFormLayout>
#include <QGroupBox>
#include <QHBoxLayout>
#include <QJsonArray>
#include <QJsonDocument>
#include <QLabel>
#include <QLineEdit>
#include <QPlainTextEdit>
#include <QPointer>
#include <QPushButton>
#include <QSpinBox>
#include <QStringList>
#include <QTabWidget>
#include <QVBoxLayout>

#include <limits>

#ifdef __EMSCRIPTEN__
#include <emscripten/val.h>
#endif

namespace {

/// The proto services the component binds (Module.endoServices, set by the
/// Manager GUI). Empty = show every service of the project (older GUIs).
QStringList boundServices()
{
    QStringList out;
#ifdef __EMSCRIPTEN__
    using emscripten::val;
    val list = val::module_property("endoServices");
    if (!list.isUndefined() && !list.isNull()) {
        const int n = list["length"].as<int>();
        for (int i = 0; i < n; ++i) out << QString::fromStdString(list[i].as<std::string>());
    }
#endif
    return out;
}

QString compact(const QJsonObject &o)
{
    return QString::fromUtf8(QJsonDocument(o).toJson(QJsonDocument::Compact));
}

}  // namespace

ServicePanel::ServicePanel(QWidget *parent)
    : QWidget(parent)
    , m_bridge(new ServiceBridge(this))
{
    const QJsonObject spec = QJsonDocument::fromJson(QByteArray(PANEL_SPEC)).object();
    const QStringList bound = boundServices();

    QList<QJsonObject> services;
    for (const QJsonValue &v : spec.value("services").toArray()) {
        const QJsonObject s = v.toObject();
        if (bound.isEmpty() || bound.contains(s.value("service").toString())) services << s;
    }

    auto *root = new QVBoxLayout(this);
    // One service shown: its name; several: the project's, with a tab each.
    auto *title = new QLabel(services.size() == 1 ? services.first().value("title").toString()
                                                  : spec.value("title").toString());
    QFont f = title->font();
    f.setBold(true);
    f.setPixelSize(16);
    title->setFont(f);
    root->addWidget(title);

    m_notice = new QLabel;
    m_notice->setWordWrap(true);
    m_notice->setStyleSheet("color: #b83227;");
    m_notice->setVisible(false);
    root->addWidget(m_notice);
    if (!m_bridge->available()) {
        m_notice->setText("Open this panel in the Manager GUI to reach the service.");
        m_notice->setVisible(true);
    }

    if (services.size() == 1) {
        root->addWidget(buildService(services.first()));
    } else {
        auto *tabs = new QTabWidget;
        for (const QJsonObject &s : services) tabs->addTab(buildService(s), s.value("title").toString());
        root->addWidget(tabs);
    }
    root->addStretch(1);
}

QWidget *ServicePanel::buildService(const QJsonObject &service)
{
    auto *page = new QWidget;
    auto *layout = new QVBoxLayout(page);
    layout->setContentsMargins(0, 0, 0, 0);
    const QString name = service.value("service").toString();
    const QJsonArray methods = service.value("methods").toArray();
    if (methods.isEmpty()) layout->addWidget(new QLabel(name + " has no methods yet."));
    for (const QJsonValue &m : methods) layout->addWidget(buildMethod(name, m.toObject()));
    return page;
}

QWidget *ServicePanel::buildMethod(const QString &serviceName, const QJsonObject &spec)
{
    const QString name = spec.value("name").toString();
    auto *box = new QGroupBox(name);
    auto *form = new QFormLayout(box);
    const QString description = spec.value("description").toString();
    if (!description.isEmpty()) box->setToolTip(description);

    if (spec.value("streaming").toBool()) {
        auto *note = new QLabel("Server-streaming: its messages show in the component's log tile.");
        note->setEnabled(false);
        form->addRow(note);
        return box;
    }

    Method m;
    m.call = serviceName + "/" + name;
    const QString request = spec.value("request").toString();
    if (request == "json") {
        // Imported proto: the request fields are not known to the generator.
        m.json = new QPlainTextEdit("{}");
        m.json->setMaximumHeight(64);
        m.json->setToolTip("The request message as JSON (proto field names)");
        form->addRow("Request", m.json);
    }
    for (const QJsonValue &v : spec.value("fields").toArray()) {
        const QJsonObject fo = v.toObject();
        Field field{ fo.value("name").toString(), fo.value("type").toString(), nullptr };
        if (field.type == "bool") {
            field.editor = new QCheckBox;
        } else if (field.type == "int") {
            auto *spin = new QSpinBox;
            spin->setRange(std::numeric_limits<int>::min(), std::numeric_limits<int>::max());
            field.editor = spin;
        } else if (field.type == "float") {
            auto *spin = new QDoubleSpinBox;
            spin->setRange(-1e12, 1e12);
            spin->setDecimals(4);
            field.editor = spin;
        } else {
            auto *edit = new QLineEdit;
            if (field.type == "json") edit->setPlaceholderText("JSON value, e.g. [1, 2]");
            field.editor = edit;
        }
        form->addRow(field.name, field.editor);
        m.fields << field;
    }

    auto *row = new QHBoxLayout;
    m.button = new QPushButton(name);
    m.result = new QLineEdit;
    m.result->setReadOnly(true);
    m.result->setPlaceholderText("response");
    row->addWidget(m.button);
    row->addWidget(m.result, 1);
    form->addRow(row);

    const int index = m_methods.size();
    m_methods << m;
    connect(m.button, &QPushButton::clicked, this, [this, index]() { callMethod(index); });
    return box;
}

bool ServicePanel::requestOf(const Method &m, QJsonObject *request, QString *error) const
{
    if (m.json) {
        QJsonParseError pe;
        const QJsonDocument doc = QJsonDocument::fromJson(m.json->toPlainText().toUtf8(), &pe);
        if (pe.error != QJsonParseError::NoError || !doc.isObject()) {
            *error = "the request must be a JSON object";
            return false;
        }
        *request = doc.object();
    }
    for (const Field &f : m.fields) {
        if (auto *c = qobject_cast<QCheckBox *>(f.editor)) {
            request->insert(f.name, c->isChecked());
        } else if (auto *s = qobject_cast<QSpinBox *>(f.editor)) {
            request->insert(f.name, s->value());
        } else if (auto *d = qobject_cast<QDoubleSpinBox *>(f.editor)) {
            request->insert(f.name, d->value());
        } else if (auto *e = qobject_cast<QLineEdit *>(f.editor)) {
            if (f.type != "json") {
                request->insert(f.name, e->text());
            } else if (!e->text().trimmed().isEmpty()) {
                // Any JSON value: parse it inside an array.
                const QJsonDocument doc = QJsonDocument::fromJson("[" + e->text().toUtf8() + "]");
                if (!doc.isArray() || doc.array().size() != 1) {
                    *error = f.name + " is not valid JSON";
                    return false;
                }
                request->insert(f.name, doc.array().first());
            }
        }
    }
    return true;
}

void ServicePanel::callMethod(int index)
{
    Method &m = m_methods[index];
    QJsonObject request;
    QString error;
    if (!requestOf(m, &request, &error)) {
        m.result->setStyleSheet("color: #b83227;");
        m.result->setText(error);
        return;
    }
    m.button->setEnabled(false);
    m.result->setStyleSheet("");
    m.result->setText("...");
    QPointer<ServicePanel> self(this);
    m_bridge->call(m.call, request, [self, index](const QJsonObject &response, const QString &err) {
        if (!self) return;
        Method &mm = self->m_methods[index];
        mm.button->setEnabled(true);
        const QString text = err.isEmpty() ? compact(response) : err;
        mm.result->setStyleSheet(err.isEmpty() ? "color: #1e8449;" : "color: #b83227;");
        mm.result->setText(text);
        mm.result->setToolTip(err.isEmpty()
            ? QString::fromUtf8(QJsonDocument(response).toJson(QJsonDocument::Indented)) : err);
        mm.result->setCursorPosition(0);
    });
}
