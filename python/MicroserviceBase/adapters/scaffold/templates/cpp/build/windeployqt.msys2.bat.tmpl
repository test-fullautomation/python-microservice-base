
:: ----- Deploy Qt runtime for the GUI (MSYS2 ships windeployqt with qt6-tools) -----
if exist "%DIST%\@@{snake_name}_gui.exe" (
    if exist "%MSYS2_ROOT%\bin\windeployqt-qt6.exe" (
        echo Running windeployqt-qt6 for @@{snake_name}_gui.exe ...
        "%MSYS2_ROOT%\bin\windeployqt-qt6.exe" --release --no-translations --no-system-d3d-compiler --no-opengl-sw --compiler-runtime "%DIST%\@@{snake_name}_gui.exe" >nul
    ) else if exist "%MSYS2_ROOT%\bin\windeployqt.exe" (
        echo Running windeployqt for @@{snake_name}_gui.exe ...
        "%MSYS2_ROOT%\bin\windeployqt.exe" --release --no-translations --no-system-d3d-compiler --no-opengl-sw --compiler-runtime "%DIST%\@@{snake_name}_gui.exe" >nul
    ) else (
        echo WARNING: windeployqt not found in %MSYS2_ROOT%\bin
        echo          Install with:  pacman -S mingw-w64-x86_64-qt6-tools
    )
)
