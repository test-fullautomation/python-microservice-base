{
  "component": "bits.uds-tester",
  "version": "0.9.2",
  "layer": "bits",
  "title": "UDS tester",
  "requires": {
    "shell": "^2.3",
    "capabilities": [
      "grpc.call"
    ]
  },
  "binds": {
    "consul": "@self",
    "grpc": "uds.v1.RequestService"
  },
  "tiles": [
    {
      "id": "req",
      "size": "2x1",
      "kind": "uds-console",
      "title": "UDS request",
      "request": "22 F1 90",
      "response": "62 F1 90 57 42 41 33 42 33 30 30 30"
    }
  ],
  "ribbon": [
    {
      "tab": "dev",
      "group": "UDS",
      "commands": [
        {
          "label": "Send request",
          "icon": "send",
          "call": "Send"
        }
      ]
    }
  ],
  "dock": [
    "api",
    "details"
  ],
  "renderer": "schema"
}
