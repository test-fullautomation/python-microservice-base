{
  "$schema": "../../../../../web/js/endo/contract/plugin.schema.json",
  "plugin": "config-demo",
  "version": "0.1.0",
  "title": "Configurations (demo)",
  "description": "Test bed: what a configuration hub service delivers to the Manager GUI. A Configurations tab, and a drawer tab, bound to the service that delivered it.",
  "requires": { "shell": "^2.3", "capabilities": ["grpc.call"] },
  "isolation": "frame",
  "binds": { "grpc": ["configuration_hub.ConfigurationHub"] },
  "contributes": {
    "navigators": [
      { "id": "configurations", "title": "Configurations", "icon": "sliders", "entry": "nav.js" }
    ],
    "drawer.tabs": [
      { "id": "versions", "title": "Versions", "icon": "clock-history", "entry": "nav.js" }
    ]
  }
}
