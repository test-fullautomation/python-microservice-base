@startuml gui_architecture
title MicroserviceManagerGUI - Dual-Host Architecture (post-migration: Consul + Nomad + gRPC)

skinparam rectangle {
    BackgroundColor<<electron>> #E1BEE7
    BackgroundColor<<web>> #BBDEFB
    BackgroundColor<<bridge>> #FFE0B2
    BackgroundColor<<broker>> LightYellow
    BackgroundColor<<shared>> #C8E6C9
}

' ============================================================================
' Electron Host (Desktop)
' ============================================================================

rectangle "Electron Host" <<electron>> {
    rectangle "main.js" as MainJS {
        rectangle "BrowserWindow\n(loads web/index.html)" as BW
        rectangle "IPC Handlers\n(show-open-dialog)" as IPC
    }
    rectangle "preload.js" as Preload {
        rectangle "contextBridge\n(window.electronAPI)" as CTX
        rectangle "Bridge Lifecycle\n(spawn / reconnect)" as BridgeLC
        rectangle "PID Persistence\n(bridge.pid)" as PID
    }
}

' ============================================================================
' Shared Web Layer (Browser-Compatible)
' ============================================================================

rectangle "web/ (Shared Codebase)" <<web>> {
    rectangle "index.html\n(Bootstrap 5 CDN)" as Index
    rectangle "app.js\n(Main Application)" as AppJS
    rectangle "window.MicroserviceManager\n(MM namespace)" as NS

    rectangle "Core JS Modules" <<shared>> {
        rectangle "ServiceClient.js\n(RPC via /api/grpc)" as SC
        rectangle "MessageProtocol.js\n(Request/Response)" as MP
        rectangle "NomadClient.js\n(/api/nomad jobs + nodes)" as LHC
        rectangle "ServiceNetwork.js\n(Consul + Nomad tabs)" as LHD
    }

    rectangle "Multi-cluster State" <<shared>> {
        rectangle "MM.connections\n{ host:port → { consulAddr,\n services, healthy } }" as Conn
        rectangle "MM.serviceToCluster\n{ serviceName → host:port }" as STB
        rectangle "sessionStorage\n(mm_connections)" as Session
    }

    rectangle "Service Plugins" <<shared>> {
        rectangle "services/{Name}/\n(dynamically loaded)" as Plugins
    }

    rectangle "UI Components" <<shared>> {
        rectangle "Sidebar\n(.broker-section\n.broker-accordion)" as Sidebar
        rectangle "Login Modal\n(Bootstrap modal)" as Login
        rectangle "Toast Notifications\n(MM.showToast)" as Toast
    }
}

' ============================================================================
' Browser Host (Standalone)
' ============================================================================

rectangle "Browser Host" <<web>> {
    rectangle "Any Browser\n(Chrome, Firefox, Edge)" as Browser
}

' ============================================================================
' FastAPI Bridge (Backend)
' ============================================================================

rectangle "FastAPI Bridge" <<bridge>> {
    rectangle "REST Endpoints" as REST {
        rectangle "POST /api/grpc/<svc>/<method>\n(via GrpcReflectClient)" as ReqAPI
        rectangle "GET /api/consul/health/<svc>\n(Consul HTTP API)" as ConnAPI
        rectangle "GET|POST /api/nomad/jobs\n(NomadHubAdapter)" as HubAPI
        rectangle "POST /api/scaffold/*\n(Service Creator)" as ImportAPI
    }
    rectangle "WebSocket" as WS {
        rectangle "WS /ws (services + logs)\n(Realtime Push)" as WSAPI
    }
    rectangle "Static Files" as Static {
        rectangle "/gui/* → web/\n(Serves HTML/JS/CSS)" as StaticFiles
    }
}

' ============================================================================
' Backend planes (one or more clusters can be added side-by-side)
' ============================================================================

rectangle "Cluster A" <<broker>> {
    rectangle "Consul agents\n(host_a:8500)" as BrokerA
    rectangle "Nomad server\n(host_a:4646)" as NomadA
    rectangle "gRPC services\n(NOMAD_PORT_grpc)" as GrpcA
}

rectangle "Cluster B" <<broker>> {
    rectangle "Consul agents\n(host_b:8500)" as BrokerB
}

' ============================================================================
' Relationships
' ============================================================================

' Electron flow
BW --> Index : loads
CTX --> NS : exposes electronAPI
BridgeLC --> REST : spawns/reconnects
PID --> BridgeLC : read/write

' Browser flow
Browser --> StaticFiles : HTTP GET /gui/
Browser --> REST : HTTP POST
Browser --> WSAPI : WebSocket

' App internal
AppJS --> SC : RPC calls
AppJS --> LHC : Nomad jobs / nodes
LHD --> LHC : uses
SC --> ReqAPI : POST /api/grpc/<svc>/<method>\n(includes consul_addr)
LHC --> HubAPI : GET|POST /api/nomad/*

' Multi-cluster
Conn --> STB : reverse lookup
Conn --> Session : persist/restore
ConnAPI --> BrokerA : Consul HTTP
ConnAPI --> BrokerB : Consul HTTP
HubAPI --> NomadA : Nomad HTTP API
ReqAPI --> GrpcA : reflection + invoke

' WebSocket
WSAPI --> AppJS : push service updates

' Service plugins
Plugins --> NS : register via namespace

' ============================================================================
' Notes
' ============================================================================

note right of NS
  **Namespace Pattern:**
  All modules access shared state
  via window.MicroserviceManager (MM).
  No require(), no module.exports.
  Works in both Electron and browser.
end note

note bottom of BridgeLC
  **Bridge Lifecycle (ADR-012):**
  1. First launch → spawn bridge (detached)
  2. Save PID to bridge.pid
  3. GUI close → bridge keeps running
  4. GUI reopen → check PID, reconnect
  5. PID dead → spawn new bridge
end note

note bottom of Conn
  **Multi-cluster (ADR-007 refreshed):**
  Each Consul cluster tracked independently.
  ServiceClient includes consul_addr in
  POST body so the bridge knows which
  catalog to resolve against.  Progressive
  disclosure: cluster headers shown when
  >1 connection (multi-broker UI pattern
  reused for multi-cluster).
end note

@enduml
