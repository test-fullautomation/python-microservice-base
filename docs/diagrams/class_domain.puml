@startuml class_domain
!theme plain
title MicroserviceBase - Domain Layer Classes

skinparam class {
    BackgroundColor<<dataclass>> #CCFFCC
    BackgroundColor<<enum>> #FFFFCC
    BackgroundColor<<exception>> #FFCCCC
    BackgroundColor<<service>> #CCE5FF
}

package "domain.models" {

    class MethodArgument <<dataclass>> {
        +name: str
        +condition: Optional[str]
        +type: Optional[str]
        +default: Optional[str]
        +description: str
        --
        +to_dict(): dict
        +{static} from_dict(data): MethodArgument
    }

    class ServiceMethod <<dataclass>> {
        +name: str
        +arguments: List[MethodArgument]
        +return_type: Optional[str]
        --
        +to_dict(): dict
        +{static} from_dict(name, data): ServiceMethod
    }

    class ServiceInfo <<dataclass>> {
        +name: str
        +description: str
        +shortdesc: str
        +group: str
        +tag: str
        +version: str = "1.0.0"
        +routing_key: str
        +gui_support: bool = False
        +methods: List[str]
        +methods_info: dict
        --
        +to_dict(): dict
        +{static} from_dict(data): ServiceInfo
    }

    ServiceInfo --> "*" ServiceMethod : methods_info
    ServiceMethod --> "*" MethodArgument : arguments
}

package "domain.messages" {

    enum ResultType <<enum>> {
        PASS = "pass"
        FAIL = "fail"
        EXCEPT = "exception"
    }

    class ServiceRequest <<dataclass>> {
        +method: str
        +args: Optional[List[Any]]
        --
        +to_dict(): dict
        +{static} from_dict(data): ServiceRequest
        +to_json(): str
        +{static} from_json(json_str): ServiceRequest
    }

    class ServiceResponse <<dataclass>> {
        +request: str
        +result: str
        +result_data: Any
        --
        +to_dict(): dict
        +{static} from_dict(data): ServiceResponse
        +to_json(): str
        +{static} from_json(json_str): ServiceResponse
        +get_json(): str
        +get_data(): Any
    }

    class ServiceEvent <<dataclass>> {
        +service_name: str
        +state: str
        +info: dict
        --
        +to_dict(): dict
        +{static} from_dict(data): ServiceEvent
        +to_json(): str
        +{static} from_json(json_str): ServiceEvent
    }

    ServiceResponse --> ResultType : result
}

package "domain.exceptions" {

    class ServiceError <<exception>> {
    }

    class TransportError <<exception>> {
    }

    class ServiceNotFoundError <<exception>> {
    }

    class MethodNotFoundError <<exception>> {
    }

    TransportError --|> ServiceError
    ServiceNotFoundError --|> ServiceError
    MethodNotFoundError --|> ServiceError
}

package "domain.service_base" {

    class ServiceBase <<service>> {
        #_SERVICE_INFO: dict
        #_SERVICE_REQUEST_EXCHANGE: str
        -_transport: TransportPort
        -_registry: ServiceRegistryPort
        --
        +__init__(transport, registry)
        +get_service_info(): ServiceInfo
        +get_service_info_dict(): dict
        +serve()
        +register_service()
        +unregister_service()
        +request_service(data, exchange, key): dict
        +close()
        +dispatch_request(body): ServiceResponse
        +on_request(ch, method, props, body)
        #is_specific_request(request): bool
        #on_specific_request(request, body): ServiceResponse
        -get_svc_api_methods_dict(): dict
        -get_svc_api_methods_info_dict(methods): dict
        -{static} parse_docstring(docstring): dict
        ..
        +svc_api_get_version(): str
        +svc_api_get_gui_files(): bytes
    }
}

package "domain.service_registry" {

    class ServiceRegistry <<service>> {
        +services_information: dict
        +realtime_update_exchange: str
        -_alias_dict: dict
        --
        +handle_update(service_information)
        +notify_updates()
        +is_specific_request(request): bool
        +handle_alias_request(body): ServiceResponse
        ..
        +svc_api_get_services_info(): str
        +svc_api_get_realtime_update_exchange(): str
        +svc_api_update_alias_conf(alias_string)
        +svc_api_get_alias_conf(): str
    }

    ServiceRegistry --|> ServiceBase : extends
}

' Cross-package relationships
ServiceBase --> ServiceInfo : creates
ServiceBase --> ServiceRequest : dispatches
ServiceBase --> ServiceResponse : returns
ServiceBase --> ServiceMethod : discovers
ServiceRegistry --> ServiceEvent : handles

@enduml
