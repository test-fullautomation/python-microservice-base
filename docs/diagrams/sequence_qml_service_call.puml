@startuml sequence_qml_service_call
title QML Service Call — Runtime Interaction Sequence

participant "User" as user
participant "QML UI\n(ServiceUI.qml)" as qml
participant "ServiceBridge\n(C++ Singleton)" as bridge
participant "QtShellMgr\n(JS Bridge)" as mgr
participant "ServiceClient\n(MM.requestService)" as client
participant "FastAPI Bridge\n(/api/grpc/<svc>/<method>)" as api
participant "GrpcReflectClient\n(or LocalProtoClient)" as reflect
participant "Consul agent" as consul
participant "C++ gRPC server\n(ServiceRunner)" as backend

== User Interacts with QML UI ==

user -> qml : Click "Say Hello" button
activate qml

qml -> bridge : ServiceBridge.callService(\n"MyQMLService",\n"Greet",\n{"name": "World"})
activate bridge

== WASM → JS Bridge (fire-and-forget) ==

bridge -> bridge : EM_ASM {\n  var svc = UTF8ToString($0);\n  var method = UTF8ToString($1);\n  var args = JSON.parse(\n    UTF8ToString($2));\n  window.callMicroservice(\n    svc, method, args);\n}

bridge -> mgr : window.callMicroservice(\n"MyQMLService", "Greet", {"name": "World"})
activate mgr
deactivate bridge

mgr -> mgr : Lookup MM.servicesInfor["MyQMLService"]\n→ full_service_name (pkg.Service)

mgr -> client : MM.requestService(\n{method: "Greet",\n args: {"name": "World"}},\nfullServiceName)
activate client

== Browser → FastAPI → gRPC (via Consul) ==

client -> api : POST /api/grpc/<svc>/Greet\n{json_payload, consul_addr}
activate api

api -> reflect : call_unary(svc, "Greet", json)
activate reflect

reflect -> consul : GET /v1/health/service/<svc>?passing
activate consul
consul --> reflect : [{address, port}]
deactivate consul

reflect -> backend : gRPC HTTP/2 call\nGreet(GreetRequest{name="World"})
activate backend

== ServiceRunner / Adapter dispatch ==

backend -> backend : grpc::Server routes by\nfull_service_name + method
backend -> backend : MyQMLService::Greet(ctx, req, resp)
backend -> backend : domain.greet("World")\n→ "Hello, World!"
backend -> backend : resp.set_message("Hello, World!")

== Response Path ==

backend --> reflect : gRPC OK\nGreetResponse{message}
deactivate backend

reflect --> api : MessageToDict(resp)\n→ {"message": "Hello, World!"}
deactivate reflect

api --> client : 200 OK + JSON body
deactivate api

client --> mgr : Promise.resolve(\n{message: "Hello, World!"})
deactivate client

== JS → WASM Callback (via _allocUTF8) ==

mgr -> mgr : Promise.then():\n_callbackResponse(\n  method, resultData)

mgr -> mgr : mPtr = _allocUTF8("Greet")\nrPtr = _allocUTF8("Hello, World!")
note right
  Manual UTF-8 marshaling
  (Qt strips _malloc/_free/ccall):
  _qtshell_malloc(len+1)
  HEAPU8.set(encoded, ptr)
  HEAPU8[ptr+len] = 0
end note

mgr -> bridge : _shellModule._qtshell_onResponse(\nmPtr, rPtr)
activate bridge

mgr -> mgr : _qtshell_free(mPtr)\n_qtshell_free(rPtr)
deactivate mgr

bridge -> bridge : handleResponse(method, result)
bridge -> qml : emit responseReceived(\n"Greet",\n"Hello, World!")
deactivate bridge

== QML UI Update ==

qml -> qml : Connections {\n  onResponseReceived:\n  resultLabel.text =\n    method + " → " + data\n}

qml --> user : Display "Hello, World!"
deactivate qml

note over user, backend
  **Error path:** If the gRPC call returns a non-OK status
  (or the bridge can't reach Consul / can't resolve the service),
  the bridge response includes the gRPC status code + message.
  The JS .catch() calls _callbackError(), which routes via
  _qtshell_onError() → handleError() → emit errorOccurred()
  to the QML Connections handler.
end note

@enduml
