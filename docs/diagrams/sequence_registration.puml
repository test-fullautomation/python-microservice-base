@startuml sequence_registration
title Service Registration Sequence (Nomad raw_exec → ServiceRunner → Consul)

participant "Nomad client" as nomad
participant "wrapper.bat / wrapper.py" as wrapper
participant "Service process\n(main.cpp / main.py)" as main
participant "ServiceRunner\n(framework)" as runner
participant "grpc::Server" as grpc
participant "Consul agent\n(local to this Nomad client)" as consul
participant "Manager GUI\n(via FastAPI bridge)" as gui

== Phase 1: Spawn ==

nomad -> wrapper : raw_exec\n  cmd.exe /c run_<svc>.bat\n  with NOMAD_PORT_grpc env var
activate wrapper

wrapper -> wrapper : set PATH (vcpkg DLLs,\nMinGW runtime, uv venv)
wrapper -> main : exec child process
activate main

== Phase 2: Service initialisation ==

main -> main : Settings settings;\n  load <PREFIX>_GRPC_PORT,\n  load <PREFIX>_CONSUL_ADDR,\n  load <PREFIX>_ADVERTISE_ADDR

main -> runner : ServiceRunner runner(settings)\nrunner.addService(adapter, "pkg.Service")
activate runner

== Phase 3: gRPC server boot ==

runner -> grpc : ServerBuilder builder
runner -> grpc : builder.AddListeningPort(\n  bind_addr:NOMAD_PORT_grpc,\n  InsecureServerCredentials)
runner -> grpc : builder.RegisterService(adapter)
runner -> grpc : reflection::InitProtoReflectionServerBuilderPlugin()
runner -> grpc : server = builder.BuildAndStart()
activate grpc

note right of grpc
  gRPC server now accepting
  HTTP/2 connections on the
  Nomad-allocated port.
end note

== Phase 4: Consul registration ==

runner -> consul : PUT /v1/agent/service/register\n{\n  "ID":      "<svc>-<random>",\n  "Name":    "<svc_snake>",\n  "Address": <ADVERTISE_ADDR>,\n  "Port":    NOMAD_PORT_grpc,\n  "Check":   { "GRPC": "host:port", "Interval": "3s" }\n}
activate consul

consul -> consul : add to catalog\nschedule first health check
note over consul
  3 seconds later: TCP probe
  to NOMAD_PORT_grpc; passes ⇒
  marks instance healthy.
end note

consul --> runner : 200 OK
deactivate consul
deactivate runner

== Phase 5: GUI / clients see the new instance ==

gui -> consul : GET /v1/health/service/<svc>?passing\n(every ~1s while open)
consul --> gui : [{ Address, Port, Tags, Status: passing }]

note over gui
  Sidebar refreshes; user can
  click into the service detail
  panel and invoke methods via
  reflection.
end note

== Steady state ==

note over wrapper, consul
  Wrapper stays alive as PID 1 of the Nomad task
  (exit propagates up to Nomad).  ServiceRunner
  blocks on server->Wait() until SIGTERM.
end note

@enduml
