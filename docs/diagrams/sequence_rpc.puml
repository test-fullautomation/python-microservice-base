@startuml sequence_rpc
title gRPC Request-Response Sequence (unary + server-streaming)

participant "Caller\n(client / peer service)" as caller
participant "ServiceClient<T>\n(channel pool +\nConsul resolver)" as client
participant "Consul agent" as consul
participant "Target Service\n(grpc::Server)" as target
participant "Domain\n(business logic)" as domain

== Discovery (cached, fast path) ==

caller -> client : Method(request)
activate caller
activate client

alt no cached channel for target
    client -> consul : GET /v1/health/service/<name>?passing
    consul --> client : [{ Address, Port }]
    client -> client : grpc::CreateChannel(addr:port)\n+ store in pool keyed by service name
end

== Unary RPC ==

client -> target : HTTP/2 stream\nPOST /<package>.<Service>/<Method>\nbody = protobuf-encoded request
activate target

target -> target : adapter receives Request*\nresp = Response()
target -> domain : domain method call
activate domain
domain --> target : domain result
deactivate domain
target -> target : adapter populates resp from result

target --> client : HTTP/2 stream:\n  trailers (Status::OK)\n  body = protobuf-encoded response
deactivate target

client --> caller : Response message
deactivate client
deactivate caller

== Server-streaming RPC ==

caller -> client : MethodStream(request)
activate caller
activate client
client -> target : HTTP/2 stream\n  POST /<package>.<Service>/<Method>
activate target

loop while data available
    target -> target : writer->Write(msg_n)
    target --> client : message frame (DATA)
    client --> caller : yield message
end

target -> target : reach end-of-stream
target --> client : trailers (Status::OK)
deactivate target

client --> caller : iteration ends
deactivate client
deactivate caller

== Errors ==

note over caller, target
  No correlation_id needed — HTTP/2 streams
  match responses to requests natively.

  Errors propagate as gRPC Status:
  • OK              — success
  • UNIMPLEMENTED   — method not registered
  • UNAVAILABLE     — channel down (triggers Consul re-resolve)
  • DEADLINE_EXCEEDED — client-side timeout
end note

@enduml
