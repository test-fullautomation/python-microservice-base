@startuml class_adapters
title MicroserviceBase - Adapter Classes (post-migration, 2026-05-07)

skinparam class {
    BackgroundColor<<abstract>> #CCCCFF
    BackgroundColor<<adapter>> #FFE0B2
    BackgroundColor<<config>> #CCFFCC
    BackgroundColor<<proxy>> #E0E0E0
    BackgroundColor<<hub>> #B2EBF2
    BackgroundColor<<grpc>> #C5E1A5
    BackgroundColor<<scaffold>> #FFCC80
    BackgroundColor<<legacy>> #DDDDDD
}

note as N1
  **Architecture status**
  Highlights = current architecture (ADRs 022-029):
  - **NomadHubAdapter / NomadClient** implement HubManagerPort over the Nomad HTTP API
  - **GrpcReflectClient** powers the GUI's API Explorer + dynamic clients
  - **FastAPIBridge** is the canonical UI bridge (browser + Electron)
  - **scaffold.generator** emits services with C++ ServiceRunner / Python gRPC servers + wrapper scripts
  Legacy = broker-era code retained for incremental migration.
end note

' ============================================================================
' Port Interfaces (shown for context)
' ============================================================================

package "ports" {
    abstract class HubManagerPort <<abstract>> {
        {abstract} +start_hub(mode, **kwargs): dict
        {abstract} +stop_hub(): dict
        {abstract} +get_status(): dict
        {abstract} +start_processes(names): dict
        {abstract} +stop_processes(names, force): dict
        {abstract} +get_config(): dict
        {abstract} +import_service(...)
        {abstract} +remove_service(name): dict
    }

    abstract class UIBridgePort <<abstract>> {
        {abstract} +start(request_handler, services_info_provider)
        {abstract} +stop()
        {abstract} +broadcast_update(services_info)
    }

    abstract class TransportPort <<legacy>> {
        {abstract} +consume(...)
        {abstract} +rpc_call(...)
        {abstract} +publish(...)
    }

    abstract class ServiceRegistryPort <<legacy>> {
        {abstract} +register(service_info)
        {abstract} +unregister(service_info)
        {abstract} +subscribe_to_events(handler)
    }
}

' ============================================================================
' Current adapters — Nomad / gRPC / FastAPI / Scaffold
' ============================================================================

package "adapters.nomad_hub" {
    class NomadHubAdapter <<hub>> {
        -_client: NomadClient
        -_datacenter: str
        -_running: bool
        -_configs: dict
        -_poll_thread: Thread
        -_on_status_change: callable
        --
        +start_hub(mode, **kwargs): dict
        +stop_hub(): dict
        +get_status(): dict
        +start_processes(names): dict
        +stop_processes(names, force): dict
        +import_service(...)
        +remove_service(name): dict
        -_poll_loop()
        -_job_spec_for(name, config): dict
    }

    class NomadClient <<hub>> {
        -_address: str
        -_token: str
        -_namespace: str
        --
        +agent_self(): dict
        +list_jobs(): list
        +read_job(id): dict
        +submit_job(spec): dict
        +deregister_job(id, purge): dict
        +read_alloc(id): dict
        +allocations_for_job(id): list
    }

    class NomadAPIError <<hub>> {
        +status: int
        +body: str
    }

    NomadHubAdapter --> NomadClient : _client
    NomadClient ..> NomadAPIError : raises
}

package "adapters.grpc_bridge" {
    class GrpcReflectClient <<grpc>> {
        -_target: str
        -_channel: grpc.Channel
        -_pool: DescriptorPool
        --
        +list_services(): list
        +list_methods(service): list
        +describe_message(name): dict
        +call_unary(service, method, json_payload): dict
        +close()
    }

    class GrpcReflectError <<grpc>> {
        +is_unimplemented: bool
    }

    class LocalProtoClient <<grpc>> {
        -_proto_dir: str
        -_target: str
        -_channel: grpc.Channel
        --
        +list_services(): list
        +list_methods(service): list
        +call_unary(service, method, json_payload): dict
    }

    GrpcReflectClient ..> GrpcReflectError : raises

    note bottom of GrpcReflectClient
      Built on grpc-reflection's
      ServerReflection RPC.  When a server
      ships without grpc++_reflection
      (e.g. vcpkg-built C++ services),
      callers fall back to LocalProtoClient
      which compiles .proto files via
      grpc_tools.protoc.
    end note
}

package "adapters.ui_bridge" {
    class FastAPIBridge <<adapter>> {
        -_host: str
        -_port: int
        -_app: FastAPI
        -_request_handler: callable
        -_services_info_provider: callable
        --
        +start(request_handler, services_info_provider)
        +stop()
        +broadcast_update(services_info)
        ..
        +/api/services
        +/api/consul/health/<svc>
        +/api/nomad/jobs
        +/api/grpc/<svc>/<method>
        +/ws (services + log stream)
    }
}

package "adapters.scaffold" {
    class Generator <<scaffold>> {
        +generate_python_service(spec): Path
        +generate_cpp_service(spec): Path
        +generate_qt_client(spec): Path
        +generate_multi_proto_workspace(spec): Path
    }

    class CppTemplate <<scaffold>> {
        +emit_main_cpp(svc): str
        +emit_cmake_lists(svc): str
        +emit_run_wrapper(svc): str
        +emit_nomad_hcl(svc): str
        +emit_readme_html(svc): str
    }

    class PythonTemplate <<scaffold>> {
        +emit_main_py(svc): str
        +emit_pyproject_toml(svc): str
        +emit_run_wrapper(svc): str
        +emit_nomad_hcl(svc): str
    }

    class SharedHelpers <<scaffold>> {
        +gen_readme(svc, fmt): str
        +sanitize_name(name): str
        +render_mermaid_topology(svc): str
    }

    Generator --> CppTemplate
    Generator --> PythonTemplate
    Generator --> SharedHelpers
}

' ============================================================================
' Legacy adapters — RabbitMQ + Local Hub (retained for migration)
' ============================================================================

package "adapters.config  <<legacy>>" {
    class RabbitMQConfig <<legacy>> {
        +host: str
        +port: int
        +username: str
        +password: str
        --
        +{static} from_cmd_args(args, service_name): RabbitMQConfig
    }

    class EventBusConfig <<legacy>> {
        +config_path: str
        --
        +load_config(): dict
        +to_config_source(**overrides): dict
    }
}

package "adapters.transport  <<legacy>>" {
    class RabbitMQTransportAdapter <<legacy>> {
        -_config: RabbitMQConfig
        -_connection: BlockingConnection
        -_channel: BlockingChannel
        --
        +consume(...)
        +rpc_call(...)
        +publish(...)
    }

    class EventBusTransportAdapter <<legacy>> {
        -_config: EventBusConfig
        -_client: EventBusClient
        --
        +consume(...)
        +rpc_call(...)
        +publish(...)
    }
}

package "adapters.registry  <<legacy>>" {
    class AMQPRegistryAdapter <<legacy>> {
        -_config: RabbitMQConfig
        --
        +register(service_info)
        +unregister(service_info)
        +subscribe_to_events(handler)
        +notify_update(services_info)
    }

    class EventBusRegistryAdapter <<legacy>> {
        -_config: EventBusConfig
        --
        +register(service_info)
        +unregister(service_info)
        +subscribe_to_events(handler)
        +notify_update(services_info)
    }
}

package "adapters.local_hub  <<legacy>>" {
    class LocalHubManager <<legacy>> {
        -_server: ProcessHubServer
        -_executor: ServiceExecutor
        -_running: bool
        -_process_config: dict
        -_raw_config: dict
        -_config_path: str
        --
        +start_hub(...)
        +stop_hub()
        +start_processes(names)
        +stop_processes(names, force)
        +import_service(...)
        +remove_service(name)
    }

    class ServiceExecutor <<legacy>> {
        -_broker_host: str
        -_broker_port: int
        -_shutdown_timeout: float
        --
        +start(name, config)
        +stop(name, force): bool
        +is_running(name): bool
    }

    LocalHubManager --> ServiceExecutor : _executor
}

' ============================================================================
' Inheritance (implements port)
' ============================================================================

NomadHubAdapter ..|> HubManagerPort
LocalHubManager ..|> HubManagerPort
FastAPIBridge ..|> UIBridgePort
RabbitMQTransportAdapter ..|> TransportPort
EventBusTransportAdapter ..|> TransportPort
AMQPRegistryAdapter ..|> ServiceRegistryPort
EventBusRegistryAdapter ..|> ServiceRegistryPort

' ============================================================================
' Composition / dependencies
' ============================================================================

RabbitMQTransportAdapter --> RabbitMQConfig
EventBusTransportAdapter --> EventBusConfig
AMQPRegistryAdapter --> RabbitMQConfig
EventBusRegistryAdapter --> EventBusConfig
FastAPIBridge ..> GrpcReflectClient : delegates /api/grpc/*
FastAPIBridge ..> NomadHubAdapter : delegates /api/nomad/*

note bottom of FastAPIBridge
  **Bridge API surface** (post-migration):
  - /api/consul/* — service discovery (Consul HTTP)
  - /api/nomad/*  — orchestration (Nomad HTTP via NomadClient)
  - /api/grpc/*   — dynamic gRPC calls (GrpcReflectClient)
  - /api/services — legacy aggregated view (back-compat)
  - /ws           — push notifications (services + logs)
end note

@enduml
