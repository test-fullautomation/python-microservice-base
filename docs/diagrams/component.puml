@startuml component
!theme plain
title MicroserviceBase - Component Diagram

skinparam component {
    BackgroundColor<<domain>> #e8f5e9
    BackgroundColor<<port>> #e3f2fd
    BackgroundColor<<adapter>> #fff3e0
    BackgroundColor<<factory>> #f3e5f5
    BackgroundColor<<gui>> #fce4ec
    BackgroundColor<<hub>> #e0f7fa
}

' ============================================================================
' Domain Components
' ============================================================================

package "Domain" <<domain>> {
    [ServiceBase] as SB <<domain>>
    [ServiceRegistry] as SR <<domain>>
    [Models\n(ServiceInfo, ServiceMethod,\nMethodArgument)] as Models <<domain>>
    [Messages\n(ServiceRequest, ServiceResponse,\nServiceEvent, ResultType)] as Msgs <<domain>>
    [Exceptions\n(ServiceError, TransportError,\nNotFoundErrors)] as Exc <<domain>>

    SR --> SB : extends
    SB --> Models : uses
    SB --> Msgs : uses
    SB --> Exc : raises
}

' ============================================================================
' Port Interfaces
' ============================================================================

package "Ports" <<port>> {
    interface "TransportPort" as TP <<port>>
    interface "ServiceRegistryPort" as RP <<port>>
    interface "UIBridgePort" as UP <<port>>
}

SB --> TP : depends on
SB --> RP : depends on

' ============================================================================
' Adapter Components
' ============================================================================

package "Adapters" <<adapter>> {

    package "RabbitMQ Stack" {
        [RabbitMQConfig] as RMQCfg <<adapter>>
        [RabbitMQTransportAdapter] as RMQT <<adapter>>
        [AMQPRegistryAdapter] as AMQPR <<adapter>>
    }

    package "EventBus Stack" {
        [EventBusConfig] as EBCfg <<adapter>>
        [EventBusTransportAdapter] as EBT <<adapter>>
        [EventBusRegistryAdapter] as EBR <<adapter>>
    }

    package "UI Stack" {
        [FastAPIBridge\n(REST + WebSocket)] as FAB <<adapter>>
    }

    package "Local Hub Stack" <<hub>> {
        [LocalHubManager\n(ProcessHub Integration)] as LHM <<hub>>
        [ServiceExecutor\n(RPC + Signal Shutdown)] as SE <<hub>>
        [ServiceImporter\n(ZIP/Folder + AST Validation)] as SI <<hub>>
    }
}

RMQT ..|> TP : implements
EBT ..|> TP : implements
AMQPR ..|> RP : implements
EBR ..|> RP : implements
FAB ..|> UP : implements

RMQT --> RMQCfg : uses
AMQPR --> RMQCfg : uses
EBT --> EBCfg : uses
EBR --> EBCfg : uses

LHM --> SE : manages
LHM --> SI : imports via

' ============================================================================
' Factory
' ============================================================================

package "Factory" <<factory>> {
    [create_transport()] as CT <<factory>>
    [create_registry()] as CR <<factory>>
    [create_ui_bridge()] as CU <<factory>>
}

CT --> RMQT : creates
CT --> EBT : creates
CR --> AMQPR : creates
CR --> EBR : creates
CU --> FAB : creates

' ============================================================================
' GUI (Dual-Host Architecture)
' ============================================================================

package "MicroserviceManagerGUI" <<gui>> {

    package "web/ (Pure Browser)" <<gui>> {
        [app.js\n(Main App)] as AppJS <<gui>>
        [ServiceClient.js\n(RPC Client)] as SC <<gui>>
        [LocalHubClient.js\n(Hub REST Client)] as LHC <<gui>>
        [LocalHubDashboard.js\n(Process Manager UI)] as LHD <<gui>>

        AppJS --> SC : uses
        AppJS --> LHC : uses
        LHD --> LHC : uses
    }

    package "electron/ (Desktop Wrapper)" <<gui>> {
        [main.js\n(BrowserWindow)] as MainJS <<gui>>
        [preload.js\n(contextBridge\n+ Bridge Lifecycle)] as Preload <<gui>>
    }
}

' ============================================================================
' External Systems
' ============================================================================

cloud "RabbitMQ Broker(s)" as RMQ
database "alias.json" as Alias
database "hub_processes.json\n(${python} placeholders)" as HubCfg
actor "Browser" as Browser
actor "Electron" as Electron

RMQT --> RMQ : AMQP
EBT --> RMQ : AMQP
AMQPR --> RMQ : AMQP
EBR --> RMQ : AMQP
SC --> FAB : HTTP/WS
LHC --> FAB : REST
SR --> Alias : loads
LHM --> HubCfg : reads/writes
FAB --> Browser : HTTP/WS
Preload --> FAB : spawns/reconnects
MainJS --> Electron : renders

' Multi-broker: GUI connects to multiple brokers
FAB --> RMQ : AMQP\n(multi-broker)

@enduml
