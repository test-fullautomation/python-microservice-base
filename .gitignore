.idea/
__pycache__/
build/
# ...but not the scaffold's build-script templates, which the C++
# generator reads at runtime
!python/MicroserviceBase/adapters/scaffold/templates/cpp/build/
build-mingw/
build-msys2/
build-wasm/
node_modules/
dist/
dist-mingw/
dist-msys2/
*.egg-info
*.log
nul

# Editor temporary/backup files
*.tmp.*

# Qt Creator user-specific project files
*.user

# Build output directories
deploy/

# CMake user presets (machine-specific)
CMakeUserPresets.json

# PlantUML jar fetched on demand for diagram regeneration
docs/diagrams/tools/plantuml.jar
# ProperDocs build output
site/

# PlantUML jar vendored at repo root for the ProperDocs build
# (fetched on the runner in CI; see .github/workflows/docs.yml)
tools/plantuml.jar

# Docs pulled in at build time by docs_hooks/copy_external_docs.py
# (canonical source: examples/docs/md; docs/gui/ is from older builds)
docs/gui/
docs/examples/

# ===================================================================
# C++ / CMake / Qt build output
# ===================================================================
# NOTE: these are DIRECTORY rules on purpose. Blanket extension rules
# like *.cmake or *.dll would swallow real tracked sources:
#   ports/microservice-base/portfile.cmake            (vcpkg port)
#   examples/_legacy/**/libs/Windows/USBaccessX64.dll (vendored lib)
# So the build dirs are listed by exact name.

# Qt / vcpkg build + deploy trees
build-qt/
build-qt-vcpkg/
dist-qt/
dist-qt-vcpkg/

# CMake working directories and metadata
CMakeFiles/
.cmake/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json

# Ninja
.ninja_deps
.ninja_log
*.ninja_log

# vcpkg installed tree (regenerated by `vcpkg install`)
vcpkg_installed/

# Qt Creator working state (clangd index, package-manager scratch)
.qtc/
.qtc_clangd/
.qtcreator/
*.autosave

# Qt moc/uic/rcc generated sources
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_autogen/

# Compiled objects and binaries produced in-tree
*.o
*.obj
*.pdb
*.ilk
*.exp

# ===================================================================
# Python tooling caches
# ===================================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.pyc
*.pyo

# Network-specific Bazel settings and CA material stay local
# (template: tools/bazel/bazelrc.user.template)
.bazelrc.user
certs/

