{
  "name": "devatservgui",
  "version": "2.1.0",
  "description": "Microservice Manager GUI - Dual hosting (Electron + Python Web)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devTools=true",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "homepage": "https://github.com/test-fullautomation/python-microservice-base",
  "author": {
    "name": "Thomas",
    "email": "Thomas.Pollerspoeck@de.bosch.com",
    "url": "https://github.com/test-fullautomation"
  },
  "maintainer": "Thomas Pollerspöck",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.3",
    "unzipper": "^0.10.14"
  },
  "build": {
    "appId": "com.bosch.devatservgui",
    "productName": "DevAtServGUI",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "!web/services/**",
      "!electron/settings.json",
      "docs/html/**/*",
      "docs/img/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py",
          "config.json",
          "hub_processes.json",
          "services/**",
          "!**/*.log",
          "!**/*.pid",
          "!**/__pycache__/**",
          "!logs/**"
        ]
      },
      {
        "from": "electron/settings.json",
        "to": "settings.json"
      },
      {
        "from": "web/services",
        "to": "web-services",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/installers",
        "to": "installers",
        "filter": [
          "*.exe",
          "*.whl"
        ]
      },
      {
        "from": "build-resources/bootstrap.sh",
        "to": "bootstrap.sh"
      },
      {
        "from": "build-resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../../examples",
        "to": "examples",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.log",
          "!**/build/**",
          "!**/dist/**",
          "!**/dist-msys2/**",
          "!**/deploy/**",
          "!**/.qt/**",
          "!**/_legacy/**"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "build-resources/README-install.html",
        "to": "README.html"
      }
    ],
    "asar": true,
    "electronLanguages": ["en-US"],
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevAtServGUI",
      "include": "build-resources/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build-resources/icon.png"
    },
    "deb": {
      "afterInstall": "build-resources/postinst.sh"
    }
  },
  "devDependencies": {
    "electron": "^27.0.2",
    "electron-builder": "^24.6.4"
  }
}
