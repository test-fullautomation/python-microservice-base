{
  "name": "devatservgui",
  "version": "2.0.0",
  "description": "Microservice Manager GUI - Dual hosting (Electron + Python Web)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devTools=true",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "homepage": "https://github.com/test-fullautomation/python-microservice-base",
  "author": {
    "name": "Thomas",
    "email": "Thomas.Pollerspoeck@de.bosch.com",
    "url": "https://github.com/test-fullautomation"
  },
  "maintainer": "Thomas Pollerspöck",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.3",
    "unzipper": "^0.10.14"
  },
  "build": {
    "appId": "com.bosch.devatservgui",
    "productName": "DevAtServGUI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "!web/services/**",
      "!electron/settings.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*.py",
          "config.json",
          "hub_processes.json",
          "services/**",
          "!**/*.log",
          "!**/*.pid",
          "!**/__pycache__/**",
          "!logs/**"
        ]
      },
      {
        "from": "electron/settings.json",
        "to": "settings.json"
      },
      {
        "from": "web/services",
        "to": "web-services",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevAtServGUI"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^27.0.2",
    "electron-builder": "^24.6.4"
  }
}
