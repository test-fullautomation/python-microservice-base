{
  "name": "microservice-manager-gui",
  "version": "2.0.0",
  "description": "Microservice Manager GUI - Dual hosting (Electron + Python Web)",
  "main": "electron/main.js",
  "scripts": {
    "start:electron": "cd electron && npm start",
    "dev:electron": "cd electron && npm run dev",
    "install:electron": "cd electron && npm install",
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --devTools=true",
    "dist": "electron-builder"
  },
  "homepage": "https://github.com/test-fullautomation/python-microservice-base",
  "author": {
    "name": "Thomas",
    "email": "Thomas.Pollerspoeck@de.bosch.com",
    "url": "https://github.com/test-fullautomation"
  },
  "maintainer": "Thomas Pollerspöck",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.3",
    "bootstrap": "^5.3.2",
    "electron-toaster": "^2.0.4",
    "file-saver": "^2.0.5",
    "fs": "^0.0.1-security",
    "jquery": "^3.7.1",
    "node-notifier": "^10.0.1",
    "path": "^0.12.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "split.js": "^1.6.5",
    "unzipper": "^0.10.14"
  },
  "build": {
    "appId": "com.example.dasgui",
    "productName": "DevAtServGUI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}_1.0.0_${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^27.0.2",
    "electron-builder": "^24.6.4"
  }
}
