#!/usr/bin/env python3
@@{header}"""
Generate Python gRPC stubs from @@{sn}.proto.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SERVICE_ROOT = HERE.parent
# .proto sources are authored in proto/; the stubs protoc emits land in
# generated/ and are checked in, so neither Bazel nor a fresh clone needs
# protoc just to import the service.
PROTO_DIR = SERVICE_ROOT / "proto"
GENERATED_DIR = SERVICE_ROOT / "@@{stub_dir}"


def main() -> int:
    """
Run grpc_tools.protoc on the service's .proto file.

Reads ``proto/<name>.proto`` and writes the stubs into ``generated/``.

Patches the generated ``_pb2_grpc.py`` so its import of the matching
``_pb2`` module uses a package-relative path — needed because the
service runs the ``generated/`` directory as a package, not as a
top-level import root.

**Returns:**

* ``exit_code``

  / *Type*: int /

  ``0`` on success.  Forwards protoc's non-zero exit code on failure;
  ``1`` when the .proto file is missing.
    """
    proto_file = PROTO_DIR / "@@{sn}.proto"
    if not proto_file.exists():
        print(f"ERROR: {proto_file} not found", file=sys.stderr)
        return 1

    GENERATED_DIR.mkdir(parents=True, exist_ok=True)
    init_py = GENERATED_DIR / "__init__.py"
    if not init_py.exists():
        init_py.write_text("", encoding="utf-8")

    cmd = [
        sys.executable, "-m", "grpc_tools.protoc",
        f"-I{PROTO_DIR}",
        f"--python_out={GENERATED_DIR}",
        f"--grpc_python_out={GENERATED_DIR}",
        str(proto_file),
    ]
    print("Running:", " ".join(cmd))
    result = subprocess.run(cmd)
    if result.returncode != 0:
        return result.returncode

    grpc_stub = GENERATED_DIR / "@@{sn}_pb2_grpc.py"
    if grpc_stub.exists():
        text = grpc_stub.read_text(encoding="utf-8")
        patched = text.replace(
            "import @@{sn}_pb2 as @@{sn_dunder}__pb2",
            "from . import @@{sn}_pb2 as @@{sn_dunder}__pb2",
        )
        if patched != text:
            grpc_stub.write_text(patched, encoding="utf-8")
            print("Patched grpc stub import to use package-relative path")

    print("Done.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
