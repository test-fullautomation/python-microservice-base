#
# BUILD.bazel for the @@{svc} service.
#
# One py_library per hexagonal layer, so the Bazel dependency graph
# mirrors the hexagon and cannot silently drift from it:
#
#     generated_lib   proto stubs, no first-party deps
#     core_lib        PURE domain + ports -- depends on NOTHING external
#     adapters_lib    infrastructure -- may depend on core + generated + pypi
#     :main           composition root binary
#
# `core_lib` having no `@pypi//...` entries is not an oversight: it is
# what proves core purity by construction. If you find yourself wanting
# to add one, the import belongs in an adapter instead.
#
# Adding a vendor adapter that needs a new pypi package means editing
# BOTH `adapters_lib` deps here AND //:requirements_lock.txt.
#

load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "generated_lib",
    srcs = glob(["generated/**/*.py"]),
    imports = ["."],
    deps = [
        "@pypi//grpcio",
        "@pypi//protobuf",
    ],
)

py_library(
    name = "core_lib",
    srcs = glob(["core/**/*.py"]),
    imports = ["."],
    # No external deps -- see the note at the top of this file.
    deps = [":generated_lib"],
)

py_library(
    name = "adapters_lib",
    srcs = glob(["adapters/**/*.py"]),
    imports = ["."],
    deps = [
        ":core_lib",
        ":generated_lib",
        "@pypi//grpcio",
    ],
)

py_binary(
    name = "main",
    srcs = [
        "main.py",
        "config.py",
        "context.py",
    ],
    imports = ["."],
    main = "main.py",
    deps = [
        ":adapters_lib",
        ":core_lib",
        ":generated_lib",
        "@pypi//pydantic",
        "@pypi//pydantic-settings",
    ],
)

# Whole-tree filegroup so installer / packaging targets can depend on the
# service directory without enumerating every file.
filegroup(
    name = "@@{sn}_folder",
    srcs = glob(["**/*"]),
)
