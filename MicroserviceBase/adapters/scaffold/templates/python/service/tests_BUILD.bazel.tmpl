#
# Test targets for @@{svc}.
#
# One py_test per test file (not one per directory) so a failure names
# the file, and so Bazel can cache and re-run them independently.
# Every target runs through ../pytest_wrapper.py because py_test executes
# a script rather than a pytest session.
#
# Environment variables tests need are forwarded from .bazelrc
# (`test --test_env=...`), NOT declared here.
#

load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pytest_wrapper.py",
    "pytest.ini",
])

py_library(
    name = "conftest_lib",
    srcs = glob(["conftest.py"], allow_empty = True),
    imports = ["../.."],
    deps = ["//@@{bazel_pkg}:core_lib"],
)

py_test(
    name = "test_@@{sn}_service",
    size = "small",
    srcs = [
        "pytest_wrapper.py",
        "unit/test_@@{sn}_service.py",
    ],
    data = ["pytest.ini"],
    imports = ["../.."],
    main = "pytest_wrapper.py",
    tags = ["framework:pytest"],
    deps = [
        ":conftest_lib",
        "//@@{bazel_pkg}:core_lib",
        "@pypi//pytest",
    ],
)

py_test(
    name = "test_core_purity",
    size = "small",
    srcs = [
        "pytest_wrapper.py",
        "architecture/test_core_purity.py",
    ],
    data = [
        "pytest.ini",
        "//@@{bazel_pkg}:@@{sn}_folder",
    ],
    imports = ["../.."],
    main = "pytest_wrapper.py",
    tags = [
        "framework:pytest",
        "architecture",
    ],
    deps = ["@pypi//pytest"],
)
