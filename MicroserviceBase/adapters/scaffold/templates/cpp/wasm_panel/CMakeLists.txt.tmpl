# @@{title} - the service's panel for the Manager GUI (Qt WebAssembly).
#
# Generated by the MicroserviceBase scaffold (gui_type "wasm"). The panel runs
# in a Manager GUI tile and reaches the service over gRPC through the GUI, so
# it links Qt Widgets only: no gRPC, protobuf or vcpkg.
#
# Build with build_wasm.bat / build_wasm.sh (Qt for WebAssembly, single-thread).
# Output: @@{target}.js + @@{target}.wasm

cmake_minimum_required(VERSION 3.21)
project(@@{target} VERSION @@{version} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_AUTOMOC ON)
set(CMAKE_AUTOUIC ON)

if(NOT EMSCRIPTEN)
    message(WARNING "@@{target} is meant for WebAssembly (build_wasm.bat / .sh); "
                    "a desktop build shows the window but cannot reach the service.")
endif()

find_package(Qt6 REQUIRED COMPONENTS Core Gui Widgets)

qt_add_executable(@@{target}
    main.cpp
    ServicePanel.h
    ServicePanel.cpp
    ServiceBridge.h
    ServiceBridge.cpp
    panel_spec.h
)

target_link_libraries(@@{target} PRIVATE Qt6::Core Qt6::Gui Qt6::Widgets)

if(EMSCRIPTEN)
    # Single-threaded: the Manager GUI page is not cross-origin isolated.
    set_target_properties(@@{target} PROPERTIES QT_WASM_PTHREAD_POOL_SIZE 0)

    # Size: optimise for size, drop image/icon plugins the panel does not use.
    target_compile_options(@@{target} PRIVATE -Oz -flto)
    target_link_options(@@{target} PRIVATE -Oz -flto)
    set_target_properties(@@{target} PROPERTIES QT_PLUGINS "")
    qt_import_plugins(@@{target}
        INCLUDE_BY_TYPE platforms Qt6::QWasmIntegrationPlugin
        EXCLUDE_BY_TYPE imageformats iconengines)
endif()
