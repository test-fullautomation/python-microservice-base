// ServicePanel.h - the service's panel in the Manager GUI (Qt WebAssembly).
//
// Generated by the MicroserviceBase scaffold (gui_type "wasm"). The panel is
// built from the method table in panel_spec.h: one group per RPC with a
// field per request field, a Call button and the response. Replace it with
// your own window (a .ui from Qt Designer works too) and keep calling the
// service through ServiceBridge.

#pragma once

#include <QJsonObject>
#include <QList>
#include <QWidget>

class QLabel;
class QLineEdit;
class QPlainTextEdit;
class QPushButton;
class ServiceBridge;

class ServicePanel : public QWidget
{
    Q_OBJECT

public:
    explicit ServicePanel(QWidget *parent = nullptr);

private:
    struct Field {
        QString name;
        QString type;          // string | int | float | bool | json
        QWidget *editor = nullptr;
    };
    struct Method {
        QString call;          // "<package.Service>/<Method>"
        QList<Field> fields;
        QPlainTextEdit *json = nullptr;   // imported protos: the request as JSON
        QPushButton *button = nullptr;
        QLineEdit *result = nullptr;
    };

    QWidget *buildService(const QJsonObject &service);
    QWidget *buildMethod(const QString &serviceName, const QJsonObject &method);
    void callMethod(int index);
    bool requestOf(const Method &m, QJsonObject *request, QString *error) const;

    ServiceBridge *m_bridge;
    QList<Method> m_methods;
    QLabel *m_notice = nullptr;
};
